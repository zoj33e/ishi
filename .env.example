# Written by scripts/setup_engine.ps1 (KataGo paths). Add your secrets by hand; never commit .env.
ISHI_KATAGO_BIN=C:\path\to\Ishi\engine\katago\katago.exe
ISHI_KATAGO_MODEL=C:\path\to\Ishi\engine\models\kata1-b18c384nbt-s9996604416-d4316597426.bin.gz
ISHI_KATAGO_HUMAN_MODEL=C:\path\to\Ishi\engine\models\b18c384nbt-humanv0.bin.gz
ISHI_KATAGO_CONFIG=C:\path\to\Ishi\engine\analysis.cfg
# ISHI_DB_PATH defaults to <repo>/data/ishi.db
ANTHROPIC_API_KEY=
ISHI_LLM_MODEL=claude-haiku-5-5
ISHI_LLM_ENABLED=true
ISHI_DEFAULT_LOCALE=th
