# Copy to .env at the repo root. Never commit .env.
# On Windows, scripts/setup_engine.ps1 fills in the ISHI_KATAGO_* lines for you.

# --- KataGo (required for play and lessons) ---
ISHI_KATAGO_BIN=/path/to/Ishi/engine/katago/katago.exe
ISHI_KATAGO_MODEL=/path/to/Ishi/engine/models/kata1-b18c384nbt-s9996604416-d4316597426.bin.gz
ISHI_KATAGO_HUMAN_MODEL=/path/to/Ishi/engine/models/b18c384nbt-humanv0.bin.gz
ISHI_KATAGO_CONFIG=/path/to/Ishi/engine/analysis.cfg

# --- Claude narration (optional) ---
# Uncomment and add your key to enable Claude. Without it, lessons use the built-in templates.
# ANTHROPIC_API_KEY=your-anthropic-api-key
ISHI_LLM_MODEL=claude-haiku-5-5
ISHI_LLM_ENABLED=true

# --- App ---
ISHI_DEFAULT_LOCALE=th
# ISHI_DB_PATH=/path/to/Ishi/data/ishi.db   # default: <repo>/data/ishi.db
# ISHI_DEV_UNLOCK_ALL=false                  # testing aid: unlock every mode regardless of belt
